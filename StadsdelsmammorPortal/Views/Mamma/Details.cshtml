@model Mamma

@{
    ViewData["Title"] = "Medlemsdetaljer";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Medlemsdetaljer</h1>

    <div>
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Redigera
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Tillbaka
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Id</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Förnamn</dt>
            <dd class="col-sm-8">@Model.Fornamn</dd>

            <dt class="col-sm-4">Efternamn</dt>
            <dd class="col-sm-8">@Model.Efternamn</dd>

            <dt class="col-sm-4">Telefonnummer</dt>
            <dd class="col-sm-8">@Model.Telefonnummer</dd>

            <dt class="col-sm-4">Område</dt>
            <dd class="col-sm-8">@Model.Omrade</dd>

            <dt class="col-sm-4">Språk</dt>
            <dd class="col-sm-8">@Model.Sprak</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                @if (Model.Status == MammaStatus.Aktiv)
                {
                    <span class="badge text-bg-success">
                        Aktiv
                    </span>
                }
                else
                {
                    <span class="badge text-bg-warning">
                        Pausad
                    </span>
                }
            </dd>

            <dt class="col-sm-4">Skapad</dt>
            <dd class="col-sm-8">
                @Model.Skapad.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            </dd>

            @if (Model.SenastUppdaterad.HasValue)
            {
                <dt class="col-sm-4">Senast uppdaterad</dt>
                <dd class="col-sm-8">
                    @Model.SenastUppdaterad.Value
                        .ToLocalTime()
                        .ToString("yyyy-MM-dd HH:mm")
                </dd>
            }
        </dl>
    </div>
</div>
